@echo off
:: Complete 1-click uninstaller: removes GoodbyeDPI service, WinDivert driver, Scheduled Tasks, Desktop buttons,
:: resets IPv4/IPv6 DNS to DHCP across all physical/detached adapters, removes interface DoH overrides, and safely restores hosts file.
net session >nul 2>&1 || (set "GDPI_SELF=%~f0" & set "GDPI_ARG=%~1" & powershell -NoProfile -Command "if ($env:GDPI_ARG) { Start-Process -FilePath $env:GDPI_SELF -ArgumentList $env:GDPI_ARG -Verb RunAs } else { Start-Process -FilePath $env:GDPI_SELF -Verb RunAs }" & exit /b)

echo Dang go cai dat hoan toan GoodbyeDPI...
sc stop GoodbyeDPI >nul 2>&1
taskkill /F /IM goodbyedpi.exe >nul 2>&1
for /L %%i in (1,1,10) do (
    sc query GoodbyeDPI | find "STOP_PENDING" >nul 2>&1 || goto :rm_stopped
    ping 192.0.2.1 -n 1 -w 50 >nul 2>&1
)
:rm_stopped
sc delete GoodbyeDPI >nul 2>&1
sc stop WinDivert >nul 2>&1
sc delete WinDivert >nul 2>&1
sc stop WinDivert14 >nul 2>&1
sc delete WinDivert14 >nul 2>&1

schtasks /delete /tn "GoodbyeDPI-On" /f >nul 2>&1
schtasks /delete /tn "GoodbyeDPI-Off" /f >nul 2>&1
schtasks /delete /tn "GoodbyeDPI-Toggle" /f >nul 2>&1
schtasks /delete /tn "PUBGWirelessAndHzGuard" /f >nul 2>&1

powershell -NoProfile -ExecutionPolicy Bypass -Command "$m = New-Object System.Threading.Mutex($false, 'Global\GoodbyeDPI_Toolkit_Mutex'); $has = $false; try { try { $has = $m.WaitOne(10000) } catch [System.Threading.AbandonedMutexException] { $has = $true }; try { $cmdProcs = @(([wmisearcher]\"SELECT ProcessId, ParentProcessId, CommandLine FROM Win32_Process WHERE Name='cmd.exe' OR Name='powershell.exe' OR ProcessId=$PID\").Get()); $myParentPid = ($cmdProcs | Where-Object { $_.ProcessId -eq $PID } | Select-Object -First 1).ParentProcessId; foreach ($cp in $cmdProcs) { if ($cp.ProcessId -ne $PID -and $cp.ProcessId -ne $myParentPid -and $cp.CommandLine -match 'goodbyedpi_(on|off)\.cmd|pubg_wireless_and_hz_guard\.ps1') { Stop-Process -Id $cp.ProcessId -Force -ErrorAction SilentlyContinue } } } catch {}; Remove-ItemProperty -Path 'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\Run' -Name 'PUBGWirelessAndHzGuard' -ErrorAction SilentlyContinue; Remove-ItemProperty -Path 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Run' -Name 'PUBGWirelessAndHzGuard' -ErrorAction SilentlyContinue; $d = [Environment]::GetFolderPath('Desktop'); Remove-Item ($d+'\GoodbyeDPI BAT.lnk'),($d+'\GoodbyeDPI TAT.lnk'),($d+'\GoodbyeDPI Bat-Tat.lnk') -Force -ErrorAction SilentlyContinue; Remove-ItemProperty -Path 'HKLM:\SYSTEM\CurrentControlSet\Services\Tcpip6\Parameters' -Name 'DisabledComponents' -ErrorAction SilentlyContinue; $nics = [System.Net.NetworkInformation.NetworkInterface]::GetAllNetworkInterfaces() | Where-Object { $_.NetworkInterfaceType -ne 'Loopback' -and $_.NetworkInterfaceType -ne 'Tunnel' -and $_.Description -notmatch 'Tailscale|WireGuard|TAP|TUN|ZeroTier|Hyper-V|Virtual|Loopback' }; foreach ($n in $nics) { $g = $n.Id; $ns4 = (Get-ItemProperty -Path \"HKLM:\SYSTEM\CurrentControlSet\Services\Tcpip\Parameters\Interfaces\$g\" -Name NameServer -ErrorAction SilentlyContinue).NameServer; if ($ns4) { & netsh.exe interface ipv4 set dnsservers name=\"$($n.Name)\" dhcp | Out-Null }; & netsh.exe interface ipv6 set interface \"$($n.Name)\" routerdiscovery=enabled | Out-Null; & netsh.exe interface ipv6 set dnsservers name=\"$($n.Name)\" dhcp | Out-Null }; Get-ChildItem 'HKLM:\SYSTEM\CurrentControlSet\Services\Tcpip\Parameters\Interfaces' -ErrorAction SilentlyContinue | ForEach-Object { if ((Get-ItemProperty -Path $_.PSPath -Name NameServer -ErrorAction SilentlyContinue).NameServer -eq '8.8.8.8,8.8.4.4') { Set-ItemProperty -Path $_.PSPath -Name NameServer -Value '' -ErrorAction SilentlyContinue } }; Get-ChildItem 'HKLM:\SYSTEM\CurrentControlSet\Services\Dnscache\InterfaceSpecificParameters' -ErrorAction SilentlyContinue | ForEach-Object { $dohBase = Join-Path $_.PSPath 'DohInterfaceSettings\Doh'; foreach ($ip in @('8.8.8.8','8.8.4.4','1.1.1.1','1.0.0.1','::1')) { if (Test-Path \"$dohBase\$ip\") { Remove-Item -Path \"$dohBase\$ip\" -Recurse -Force -ErrorAction SilentlyContinue } } }; foreach ($exe in @('TslGame.exe','ExecPubg.exe','TslGame_BE.exe','TslGame_ZK.exe')) { $ifeoP = \"HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Image File Execution Options\$exe\PerfOptions\"; if (Test-Path $ifeoP) { Remove-Item -Path $ifeoP -Recurse -Force -ErrorAction SilentlyContinue } }; $pf86 = ${env:ProgramFiles(x86)}; $pubgDir = (Get-ItemProperty -Path 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Steam App 578080' -Name InstallLocation -ErrorAction SilentlyContinue).InstallLocation; if (-not $pubgDir) { $pubgDir = Join-Path $pf86 'Steam\steamapps\common\PUBG' }; Remove-MpPreference -ExclusionPath @($pubgDir, \"$env:LOCALAPPDATA\TslGame\", (Join-Path $pf86 'Common Files\BattlEye'), (Join-Path $pf86 'Common Files\BattlEye\BEDaisy.sys'), 'C:\Program Files\Common Files\PUBG', 'C:\Program Files\Common Files\PUBG\navagio.sys') -ExclusionProcess @('TslGame.exe','TslGame_ZK.exe','TslGame_BE.exe','ExecPubg.exe','BEService.exe','BEService_pubg.exe','BEService_x64.exe','BEDaisy.sys','zksvc.exe','navagio.sys','CoherentUI_Host.exe') -ErrorAction SilentlyContinue; $movDir = Join-Path $pubgDir 'TslGame\Content\Movies'; if ([System.IO.Directory]::Exists($movDir)) { foreach ($bak in [System.IO.Directory]::GetFiles($movDir, '*.mp4.bak', [System.IO.SearchOption]::AllDirectories)) { $origMp4 = $bak.Substring(0, $bak.Length - 4); try { [System.IO.File]::SetAttributes($bak, [System.IO.FileAttributes]::Normal); if (-not [System.IO.File]::Exists($origMp4)) { [System.IO.File]::Move($bak, $origMp4) } } catch {} } }; $engIni = Join-Path $env:LOCALAPPDATA 'TslGame\Saved\Config\WindowsNoEditor\Engine.ini'; if ([System.IO.File]::Exists($engIni)) { try { [System.IO.File]::SetAttributes($engIni, [System.IO.FileAttributes]::Normal) } catch {} }; $stJson = Join-Path $env:LOCALAPPDATA 'TslGame\Saved\pubg_autofix_state.json'; if ([System.IO.File]::Exists($stJson)) { try { $stObj = [System.IO.File]::ReadAllText($stJson) | ConvertFrom-Json; if ($stObj -and $stObj.WarpRunValues) { foreach ($p in $stObj.WarpRunValues.PSObject.Properties) { if ($p.Value -and $p.Name -match '^Cloudflare') { Set-ItemProperty -Path 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Run' -Name $p.Name -Value ([string]$p.Value) -ErrorAction SilentlyContinue } } } } catch {}; Remove-Item -LiteralPath $stJson -Force -ErrorAction SilentlyContinue }; $h = \"$env:SystemRoot\System32\drivers\etc\hosts\"; for ($i=0; $i -lt 5; $i++) { try { $lines = [System.IO.File]::ReadAllLines($h, [System.Text.Encoding]::UTF8); $clean = [string[]]@($lines | Where-Object { $_ -notmatch 'prod-live-front\.playbattlegrounds\.com' }); [System.IO.File]::WriteAllLines($h, $clean, (New-Object System.Text.UTF8Encoding($false))); break } catch { Start-Sleep -Milliseconds 40 } } } finally { if ($has) { try { $m.ReleaseMutex() } catch {} }; $m.Dispose() }" >nul 2>&1
ipconfig /flushdns >nul 2>&1

echo Da go cai dat GoodbyeDPI, xoa 2 nut Desktop, khoi phuc DNS DHCP va file hosts.
if /I "%~1"=="--nopause" exit /b 0
pause
